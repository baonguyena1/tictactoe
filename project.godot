; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tic Tac Toe"
run/main_scene="uid://chvhbv1yor2ei"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.95, 0.93, 0.89, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://resources/textures/splash_boot.png"
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"
general/ios/session_category=3
general/ios/mix_with_others=true

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/ai/plugin.cfg", "res://addons/core/plugin.cfg", "res://addons/godotx_safe_area/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/learning/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/fallback="en"
locale/translations=PackedStringArray("res://resources/i18n/strings.en.translation", "res://resources/i18n/strings.vi.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.95, 0.93, 0.89, 1)
